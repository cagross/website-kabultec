<?xml version="1.0"?>
<ruleset name="Spacious Child">
    <arg name="extensions" value="php"/>
    <arg value="sp"/>

    <rule ref="WordPress"/>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="spacious"/>
            </property>
        </properties>
    </rule>
</ruleset>
